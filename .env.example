# ============================================================
# LedgerAI — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit real secrets. This file documents required vars.
# ============================================================

# ---- Database (Supabase Postgres) ---------------------------
# Two connection strings with different jobs:
#
# DATABASE_URL — the APP RUNTIME connection. Use the Supabase TRANSACTION
# pooler (port 6543). It multiplexes many short-lived serverless instances over
# a small server-side pool, so each instance keeps a tiny client pool
# (DB_POOL_MAX, default 1 in production). Do NOT point this at the session
# pooler (port 5432): every serverless instance then holds its own session
# connection and can exhaust the pooler's session-mode limit
# (EMAXCONNSESSION).
#
# DIRECT_URL — the ADMIN/MIGRATION connection. Use the Supabase SESSION pooler
# (port 5432) or the direct database connection. prisma.config.ts prefers it
# for `prisma migrate` / `prisma db` commands, and the weekly backup workflow
# reads it from the GitHub `DIRECT_URL` secret. pg_dump must NEVER use port
# 6543: the transaction pooler rejects the session-level features it needs.
#
# Always append ?sslmode=require: Supabase refuses unencrypted connections, and
# stating it explicitly keeps the requirement visible in config review.
# Also append uselibpqcompat=true. Prisma accepts plain ?sslmode=require, but
# node-postgres (used by prisma/apply-rls.ts and prisma/seed.ts) currently maps
# "require" to full certificate verification, which the Supabase pooler chain
# fails with "self-signed certificate in certificate chain". uselibpqcompat=true
# gives node-postgres libpq semantics (encrypt the link, skip chain
# verification) so a single connection string works for both drivers.
# Example (runtime, transaction pooler):
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
# Example (migrations/backups, session pooler or direct):
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
DATABASE_URL=""
DIRECT_URL=""

# Optional: pg pool size per app server instance. Defaults to 1 in production
# and 5 in development. Positive integers only; invalid values fall back to the
# default. Keep this small when DATABASE_URL uses the transaction pooler.
DB_POOL_MAX=""

# ---- Supabase (Auth + Storage + RLS) ------------------------
# Project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=""
# Anon/publishable key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key. SERVER-ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""
# Private storage bucket for uploaded statements/receipts
SUPABASE_STORAGE_BUCKET="ledgerai-documents"

# ---- Demo seed (DEVELOPMENT / TEST ONLY) --------------------
# The demo seed (prisma/seed.ts) is gated hard: it only runs with an explicit
# SEED_ALLOW=development and is refused outright when NODE_ENV=production.
# The demo account password is NEVER written in source — supply it here at
# runtime, and only ever in a dev/test database. Leave it empty to skip
# creating the demo user on refresh runs. Do NOT set these in production.
SEED_ALLOW=""
SEED_DEMO_PASSWORD=""

# ---- AI (optional; deterministic fallback without a key) ----
# The AI layer works with deterministic rules/fallbacks when no key
# is set. When configured, it uses the selected provider.
# Example provider: "openai" | "anthropic" | "openrouter"
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
# ---- Ask surfaces (hidden at launch; both default OFF) ----
# /ask and /ask-v2 are intentionally NOT part of the shipped product: both
# routes answer 404, the Ask navigation item is not rendered, and the flags
# below keep their server actions inert. Leave them OFF. Flipping a flag alone
# does NOT re-expose the product - see OPERATIONS.md section 5.
# ASK_ENABLED=false | true
ASK_ENABLED="false"
# Independent /ask-v2 surface gate. Safe default is OFF: the v2 route and its
# server action are inert unless explicitly enabled. Independent of the v1
# /ask AI-mode flags (ASK_LLM_MODE and friends) and of provider config.
# ASK_V2_ENABLED=false | true
ASK_V2_ENABLED="false"

# ---- App configuration --------------------------------------
# Public base URL of the app, used to build redirect links that get emailed to
# users (e.g. the Supabase confirmation link). Set to your production URL when
# deploying, e.g. https://app.example.com
# Leave EMPTY in development: the app then derives the base URL from the
# incoming request (localhost on the laptop, your machine's LAN address when
# accessed from a phone) instead of hardcoding a dev URL.
# REMEMBER: also allow these URLs in Supabase Dashboard > Auth > URL
# Configuration ("Site URL" and "Redirect URLs").
NEXT_PUBLIC_APP_URL=""

# ---- Error monitoring (Sentry; optional) --------------------
# Leave EMPTY to disable monitoring entirely (the SDK is inert without a DSN).
# A Sentry DSN is a public, write-only ingest key — it is safe to expose to the
# browser, so one `NEXT_PUBLIC_` value configures server, edge and client.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional: label events by environment (defaults to VERCEL_ENV, then NODE_ENV).
SENTRY_ENVIRONMENT=""
# Optional: performance-trace sample rate, 0..1 (default 0.1 in production).
SENTRY_TRACES_SAMPLE_RATE=""
# Optional: only needed to upload source maps at build time. When these are
# absent, debug IDs are still injected but no source maps are uploaded, so
# local and CI builds stay hermetic. Set them in the Vercel build environment.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ---- Backups (configuration lives in the Supabase dashboard) -
# Backups are managed by Supabase, not by this app:
#   * Free/Pro: daily automatic backups with a short retention window.
#   * Pro+: enable Point-in-Time Recovery (PITR) for second-level RPO.
# Enable PITR and confirm the backup schedule in
# Supabase Dashboard > Database > Backups. The app writes only to Supabase
# Postgres, so a Supabase restore is a complete recovery of user data. See the
# launch runbook for the restore drill.

